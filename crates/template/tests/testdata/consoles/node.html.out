</td>
  <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=node_memory_MemFree_bytes%7Bjob%3D%27node%27%2Cinstance%3D%27localhost%3A9090%27%7D&#43;%2B&#43;node_memory_Cached_bytes%7Bjob%3D%27node%27%2Cinstance%3D%27localhost%3A9090%27%7D&#43;%2B&#43;node_memory_Buffers_bytes%7Bjob%3D%27node%27%2Cinstance%3D%27localhost%3A9090%27%7D&amp;g0.tab=0">1B</a>
