<div class="prom_console_rhs">
<table class="table table-bordered table-hover table-sm">

<tr>
  <th>Node</th>
  <th>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=sum%28up%7Bjob%3D%27node%27%7D%29&amp;g0.tab=0">1</a>
 / 

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=count%28up%7Bjob%3D%27node%27%7D%29&amp;g0.tab=0">1</a>
</th>
</tr>

</table>
