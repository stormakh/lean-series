<div class="prom_console_rhs">
<table class="table table-bordered table-hover table-sm">

  <tr>
    <th colspan="2">Overview</th>
  </tr>
  <tr>
    <td>CPU</td>
    <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=irate%28process_cpu_seconds_total%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%7D%5B5m%5D%29&amp;g0.tab=0">1s/s</a>
</td>
  </tr>
  <tr>
    <td>Memory</td>
    <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=process_resident_memory_bytes%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%7D&amp;g0.tab=0">1B</a>
</td>
  </tr>
  <tr>
    <td>Version</td>
    <td></td>
  </tr>

  <tr>
    <th colspan="2">Storage</th>
  </tr>
  <tr>
    <td>Ingested Samples</td>
    <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=irate%28prometheus_tsdb_head_samples_appended_total%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%7D%5B5m%5D%29&amp;g0.tab=0">1/s</a>
</td>
  </tr>
  <tr>
    <td>Head Series</td>
    <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=prometheus_tsdb_head_series%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%7D&amp;g0.tab=0">1</a>
</td>
  </tr>
  <tr>
    <td>Blocks Loaded</td>
    <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=prometheus_tsdb_blocks_loaded%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%7D&amp;g0.tab=0">1</a>
</td>
  </tr>
  <tr>
    <th colspan="2">Rules</th>
  </tr>
  <tr>
    <td>Evaluation Duration</td>
    <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=irate%28prometheus_evaluator_duration_seconds_sum%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%7D%5B5m%5D%29&#43;%2F&#43;irate%28prometheus_evaluator_duration_seconds_count%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%7D%5B5m%5D%29&amp;g0.tab=0">1s</a>
</td>
  </tr>
  <tr>
    <td>Notification Latency</td>
    <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=irate%28prometheus_notifications_latency_seconds_sum%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%7D%5B5m%5D%29&#43;%2F&#43;irate%28prometheus_notifications_latency_seconds_count%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%7D%5B5m%5D%29&amp;g0.tab=0">1s</a>
</td>
  </tr>
  <tr>
    <td>Notification Queue</td>
    <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=prometheus_notifications_queue_length%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%7D&amp;g0.tab=0">1</a>
</td>
  </tr>
  <tr>
    <th colspan="2">HTTP Server</th>
  </tr>

  <tr>
    <td></td>
    <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=irate%28prometheus_http_request_duration_seconds_count%7Bjob%3D%27prometheus%27%2Cinstance%3D%27localhost%3A9090%27%2Chandler%3D%27%27%7D%5B5m%5D%29&amp;g0.tab=0">1/s</a>
</td>
  </tr>

  <tr>
    <td></td>
    <td>

<a class="prom_query_drilldown" href="/prom//graph?g0.expr=irate%28prometheus_http_request_duration_seconds_count%7Bjob%3D%27prometheus%27%2Cinstance%3D%27b%3A9100%27%2Chandler%3D%27%27%7D%5B5m%5D%29&amp;g0.tab=0">1/s</a>
</td>
  </tr>



</table>
</div>



<div class="prom_console_content">
  <div class="container-fluid">

<div class="prom_graph_timecontrol">
  <div class="prom_graph_timecontrol_inner">
    <div class="prom_graph_timecontrol_group ">
      <button class="btn btn-light pull-left" type="button" id="prom_graph_duration_shrink" title="Shrink the time range.">
        <i class="glyphicon glyphicon-minus"></i>
      </button><input class="input pull-left align-middle" size="3" title="Time range of graph" type="text" id="prom_graph_duration"><button class="btn btn-light pull-left" type="button" id="prom_graph_duration_grow" title="Grow the time range.">
        <i class="glyphicon glyphicon-plus"></i>
      </button>
    </div>
    <div class="prom_graph_timecontrol_group ">
      <button class="btn btn-light pull-left" type="button" id="prom_graph_time_back" title="Rewind the end time.">
        <i class="glyphicon glyphicon-backward"></i>
      </button><input class="input pull-left align-middle" title="End time of graph" placeholder="Until" type="text" id="prom_graph_time_end" size="16" value=""><button class="btn btn-light pull-left" type="button" id="prom_graph_time_forward" title="Advance the end time.">
        <i class="glyphicon glyphicon-forward"></i>
      </button>
    </div>
    <div class="prom_graph_timecontrol_group ">
      <div class="btn-group dropup prom_graph_timecontrol_refresh pull-left">
        <button type="button" class="btn btn-light pull-left" id="prom_graph_refresh_button" title="Refresh.">
          <i class="glyphicon glyphicon-repeat"></i>
          <span class="icon-repeat"></span>
          (<span id="prom_graph_refresh_button_value">Off</span>)
        </button>
        <button type="button" class="btn btn-light pull-left dropdown-toggle" data-toggle="dropdown" title="Set autorefresh."aria-haspopup="true" aria-expanded="false">
          <span class="caret"></span>&nbsp;
        </button>
        <ul class="dropdown-menu" id="prom_graph_refresh_intervals" role="menu">
        </ul>
      </div>
    </div>
  </div>
  <script>
  new PromConsole.TimeControl();
  </script>
</div>


 <div class="prom_content_div">
  <h1>Prometheus Overview - localhost:9090</h1>

  <h3>Ingested Samples</h3>
  <div id="samplesGraph"></div>
  <script>
  new PromConsole.Graph({
    node: document.querySelector("#samplesGraph"),
    expr: "irate(prometheus_tsdb_head_samples_appended_total{job='prometheus',instance='localhost:9090'}[5m])",
    name: 'Ingested Samples',
    yAxisFormatter: PromConsole.NumberFormatter.humanizeNoSmallPrefix,
    yHoverFormatter: PromConsole.NumberFormatter.humanizeNoSmallPrefix,
    yTitle: "Samples",
    yUnits: "/s",
  })
  </script>

  <h3>HTTP Server</h3>
  <div id="serverGraph"></div>
  <script>
  new PromConsole.Graph({
    node: document.querySelector("#serverGraph"),
    expr: "irate(prometheus_http_request_duration_seconds_count{job='prometheus',instance='localhost:9090'}[5m])",
    name: '[[handler]]',
    yAxisFormatter: PromConsole.NumberFormatter.humanizeNoSmallPrefix,
    yHoverFormatter: PromConsole.NumberFormatter.humanizeNoSmallPrefix,
    yTitle: "Requests",
    yUnits: "/s",
  })
  </script>
 </div>

  </div>
</div>



</body>
</html>

