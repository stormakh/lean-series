global:
  scrape_interval: 1s
  evaluation_interval: 1s
  external_labels:
    site: lab

rule_files:
  - RULES

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:AMPORT']

scrape_configs:
  - job_name: e2e
    static_configs:
      - targets: ['127.0.0.1:9900']
    fallback_scrape_protocol: PrometheusText0.0.4
