{
 "TestAggregateExprPretty": [
  {
   "in": "sum(foo)",
   "out": "sum(foo)"
  },
  {
   "in": "sum by() (task:errors:rate10s{job=\"s\"})",
   "out": "sum(\n  task:errors:rate10s{job=\"s\"}\n)"
  },
  {
   "in": "sum without(job,foo) (task:errors:rate10s{job=\"s\"})",
   "out": "sum without (job, foo) (\n  task:errors:rate10s{job=\"s\"}\n)"
  },
  {
   "in": "sum(task:errors:rate10s{job=\"s\"}) without(job,foo)",
   "out": "sum without (job, foo) (\n  task:errors:rate10s{job=\"s\"}\n)"
  },
  {
   "in": "sum by(job,foo) (task:errors:rate10s{job=\"s\"})",
   "out": "sum by (job, foo) (\n  task:errors:rate10s{job=\"s\"}\n)"
  },
  {
   "in": "sum (task:errors:rate10s{job=\"s\"}) by(job,foo)",
   "out": "sum by (job, foo) (\n  task:errors:rate10s{job=\"s\"}\n)"
  },
  {
   "in": "topk(10, ask:errors:rate10s{job=\"s\"})",
   "out": "topk(\n  10,\n  ask:errors:rate10s{job=\"s\"}\n)"
  },
  {
   "in": "sum by(job,foo) (sum by(job,foo) (task:errors:rate10s{job=\"s\"}))",
   "out": "sum by (job, foo) (\n  sum by (job, foo) (\n    task:errors:rate10s{job=\"s\"}\n  )\n)"
  },
  {
   "in": "sum by(job,foo) (sum by(job,foo) (sum by(job,foo) (task:errors:rate10s{job=\"s\"})))",
   "out": "sum by (job, foo) (\n  sum by (job, foo) (\n    sum by (job, foo) (\n      task:errors:rate10s{job=\"s\"}\n    )\n  )\n)"
  },
  {
   "in": "sum by(job,foo)\n(sum by(job,foo) (task:errors:rate10s{job=\"s\"}))",
   "out": "sum by (job, foo) (\n  sum by (job, foo) (\n    task:errors:rate10s{job=\"s\"}\n  )\n)"
  },
  {
   "in": "sum by(job,foo)\n(sum(task:errors:rate10s{job=\"s\"}) without(job,foo))",
   "out": "sum by (job, foo) (\n  sum without (job, foo) (\n    task:errors:rate10s{job=\"s\"}\n  )\n)"
  },
  {
   "in": "sum by(job,foo) # Comment 1.\n(sum by(job,foo) ( # Comment 2.\ntask:errors:rate10s{job=\"s\"}))",
   "out": "sum by (job, foo) (\n  sum by (job, foo) (\n    task:errors:rate10s{job=\"s\"}\n  )\n)"
  }
 ],
 "TestBinaryExprPretty": [
  {
   "in": "a+b",
   "out": "a + b"
  },
  {
   "in": "a == bool 1",
   "out": "  a\n== bool\n  1"
  },
  {
   "in": "a + ignoring(job) b",
   "out": "  a\n+ ignoring (job)\n  b"
  },
  {
   "in": "foo_1 + foo_2",
   "out": "  foo_1\n+\n  foo_2"
  },
  {
   "in": "foo_1 + foo_2 + foo_3",
   "out": "    foo_1\n  +\n    foo_2\n+\n  foo_3"
  },
  {
   "in": "foo + baar + foo_3",
   "out": "  foo + baar\n+\n  foo_3"
  },
  {
   "in": "foo_1 + foo_2 + foo_3 + foo_4",
   "out": "      foo_1\n    +\n      foo_2\n  +\n    foo_3\n+\n  foo_4"
  },
  {
   "in": "foo_1 + ignoring(foo) foo_2 + ignoring(job) group_left foo_3 + on(instance) group_right foo_4",
   "out": "      foo_1\n    + ignoring (foo)\n      foo_2\n  + ignoring (job) group_left ()\n    foo_3\n+ on (instance) group_right ()\n  foo_4"
  }
 ],
 "TestCallExprPretty": [
